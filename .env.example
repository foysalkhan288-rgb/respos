# Environment
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-7b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Payments — when STRIPE_API_KEY is set, card/mobile charges go to Stripe;
# otherwise the mock gateway approves locally. Cash always settles via drawer.
STRIPE_API_KEY=

# Database
DB_PATH=cafe_os.db

# Server
HOST=0.0.0.0
PORT=8000
