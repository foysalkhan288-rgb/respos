# Environment
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-7b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Payments — when STRIPE_API_KEY is set, card/mobile charges go to Stripe;
# otherwise the mock gateway approves locally. Cash always settles via drawer.
STRIPE_API_KEY=

# Sales tax rate applied at checkout (default 0.10)
TAX_RATE=0.10

# Production backends (optional — SQLite is the default)
# DATABASE_URL=postgresql://cafe_os:cafe_os@localhost:5432/cafe_os
# REDIS_URL=redis://localhost:6379/0

# Database (SQLite path, ignored when DATABASE_URL is set)
DB_PATH=cafe_os.db

# Server
HOST=0.0.0.0
PORT=8000
